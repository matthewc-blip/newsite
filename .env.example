# Copy to .env for local use. On a host, set these in its environment settings.
PORT=3000
PUBLIC_URL=https://www.yourdomain.com

# Supabase database connection string.
# Supabase dashboard > your project > Connect (top bar) > "Session pooler" > URI.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Dispatch dashboard login (/admin). Use a long password.
ADMIN_PASSWORD=change-me-to-something-long
# Random string that signs desk logins. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Email (optional but recommended). Any SMTP provider works: Google Workspace, Microsoft 365, Postmark, SendGrid, Resend, Mailgun.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MCC Solutions <bookings@yourdomain.com>
# New bookings, cancellations, applications and messages are sent here
DESK_EMAIL=dispatch@yourdomain.com

# Notary documents (optional but recommended). Without these, uploads are stored in the database.
# Supabase dashboard > Project Settings > API: copy the Project URL and the service_role secret key.
# Keep the service_role key secret: never put it in website code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Text messages to notaries for job offers (optional). Twilio account SID, auth token and your Twilio number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550100


# Billing through Stripe. Stripe pays out to the bank you connect in Stripe (e.g. Mercury).
# Stripe dashboard > Developers > API keys. Use sk_test_... first, then sk_live_...
STRIPE_SECRET_KEY=
# Stripe dashboard > Developers > Webhooks > add endpoint https://YOUR-SITE/api/webhooks/stripe
# Events: invoice.paid, invoice.voided, invoice.marked_uncollectible, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
